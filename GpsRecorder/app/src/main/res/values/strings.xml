<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">GPS Recorder</string>

    <!-- Setup -->
    <string name="setup_heading">Server Setup</string>
    <string name="hint_setup_code">Paste setup code copied from web</string>
    <string name="enter_manually">Enter server URL and key manually instead</string>
    <string name="hint_server_url">Server URL (e.g. https://example.com)</string>
