    <string name="bg_location_title">Background Location</string>
    <string name="bg_location_message">To record GPS while the screen is off, please allow "Allow all the time" in the next prompt.</string>
    <string name="grant">Grant</string>
    <string name="permission_denied_title">Permission Needed</string>
    <string name="permission_denied_message">%1$s permission is required to record GPS.</string>

