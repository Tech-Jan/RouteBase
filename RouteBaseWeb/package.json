{
  "name": "routebase-web",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "vite build --config vite.config.esm.ts",
    "dev": "vite build --watch --config vite.config.esm.ts",
    "typecheck": "tsc --noEmit",
    "gen:contracts": "node scripts/gen-contracts.mjs",
    "lint": "eslint src/js/",
    "lint:fix": "eslint src/js/ --fix",
    "lint:css": "stylelint \"wwwroot/css/**/*.css\"",
    "lint:css:dead": "node scripts/check-dead-css-selectors.mjs",
    "format": "prettier --write src/js/",
    "format:check": "prettier --check src/js/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "chart.js": "4.5.1",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "jsdom": "29.1.1",
    "knip": "^6.31.0",
    "maplibre-gl": "5.24.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.8.3",
    "stylelint": "^16.10.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.9"
  }
}
