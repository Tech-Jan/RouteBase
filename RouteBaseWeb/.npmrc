# openapi-typescript (build-time contract codegen) declares peer typescript@^5.x, but this repo runs
# typescript@6.x. The peer IS satisfied (the compiler API it uses is compatible) — its published range
# just lags TS 6. legacy-peer-deps tells npm not to hard-fail on that stale range, so `npm ci` (invoked
# by the csproj NpmInstall target) and `npm install` both resolve. Revisit once openapi-typescript widens
# its peer range to include TS 6.
legacy-peer-deps=true
